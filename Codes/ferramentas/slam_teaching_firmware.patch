+// Prazo do último comando de roda (µs, esp_timer). 0 = sem prazo (comportamento antigo: mantém a última velocidade).
+// Definido quando o comando traz "ttl_ms": se não chegar outro comando a tempo, o controle zera as referências.
+static volatile int64_t s_cmd_deadline_us = 0;
+
+static const char *reset_reason_str(void) {
+    switch (esp_reset_reason()) {
+        case ESP_RST_POWERON:   return "POWERON (energia ligada/cortada)";
+        case ESP_RST_BROWNOUT:  return "BROWNOUT (queda de tensao)";
+        case ESP_RST_PANIC:     return "PANIC (excecao no firmware)";
+        case ESP_RST_INT_WDT:   return "INT_WDT (watchdog de interrupcao)";
+        case ESP_RST_TASK_WDT:  return "TASK_WDT (watchdog de tarefa)";
+        case ESP_RST_WDT:       return "WDT (outro watchdog)";
+        case ESP_RST_SW:        return "SW (esp_restart)";
+        case ESP_RST_EXT:       return "EXT (pino de reset)";
+        case ESP_RST_DEEPSLEEP: return "DEEPSLEEP";
+        case ESP_RST_SDIO:      return "SDIO";
+        case ESP_RST_USB:       return "USB";
+        case ESP_RST_PWR_GLITCH: return "PWR_GLITCH (falha rapida de energia)";
+        case ESP_RST_CPU_LOCKUP: return "CPU_LOCKUP";
+        default:                return "DESCONHECIDO";
+    }
+}
